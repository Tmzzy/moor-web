# Required management login password. Replace this before starting Moor.
MOOR_PASSWORD=replace-with-a-long-random-password

# Optional management username.
MOOR_USERNAME=moor

# Public URL used in generated MCP client snippets.
MOOR_PUBLIC_URL=http://localhost:9223

# MCP access uses tokens generated per Profile in Moor; there is no global MCP token setting.

# Keep the backend private when a reverse proxy runs on the same host.
MOOR_BIND_ADDRESS=127.0.0.1
MOOR_HTTP_PORT=9223
